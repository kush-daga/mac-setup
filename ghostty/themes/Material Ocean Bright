# Material Ocean Bright — a custom variant, not a Ghostty built-in.
#
# Material Ocean's own foreground is #8f93a2: a low-saturation mid-grey that
# measures 6.1:1 against its near-black #0f111a ground. It passes contrast
# checks and still reads as dim, because saturation and lightness both sit
# low. This keeps the near-black ground and lifts the text to 13.5:1.
#
# Changed: foreground, the two dim-grey palette slots (0/8, used for
# comments and de-emphasised UI), and the selection. The six accent hues are
# already bright and are untouched, so syntax highlighting looks identical.

background = #0f111a
foreground = #d5dae8

# 0/8 are the "dim" slots. Material Ocean sets both to #546e7a, which is
# almost invisible on this ground — it's what made comments and secondary
# text disappear. Lifted, while staying clearly recessed from #d5dae8.
palette = 0=#7887a0
palette = 8=#8fa0ba

palette = 1=#ff5370
palette = 9=#ff5370
palette = 2=#c3e88d
palette = 10=#c3e88d
palette = 3=#ffcb6b
palette = 11=#ffcb6b
palette = 4=#82aaff
palette = 12=#82aaff
palette = 5=#c792ea
palette = 13=#c792ea
palette = 6=#89ddff
palette = 14=#89ddff
palette = 7=#ffffff
palette = 15=#ffffff

cursor-color = #ffcc00
cursor-text = #0f111a
selection-background = #2b3350
selection-foreground = #eaeefb
