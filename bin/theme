#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
#  theme — switch the colour scheme of every tool at once.
#
#    theme                    interactive picker
#    theme nord               switch directly
#    theme list               show available themes
#    theme current            print the active theme
#
#  Sources of truth: $DOTFILES/themes/<name>.sh
#  Generated files (all outside git) are rewritten on every switch.
# ═══════════════════════════════════════════════════════════════════════
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$DOTFILES/themes"
STATE="$XDG_CONFIG_HOME/theme"

die() { printf '\033[31merror:\033[0m %s\n' "$1" >&2; exit 1; }

list_themes() { find "$THEME_DIR" -name '*.sh' -exec basename {} .sh \; | sort; }

current_theme() { [[ -r "$STATE" ]] && tr -d '[:space:]' < "$STATE" || echo "tokyonight-storm"; }

case "${1:-}" in
  list|ls)   list_themes; exit 0 ;;
  current)   current_theme; exit 0 ;;
  -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# ── Pick the theme ───────────────────────────────────────────────────────
if [[ -n "${1:-}" ]]; then
  NAME="$1"
else
  NAME=$(list_themes | fzf --prompt='theme ❯ ' --height=40% --reverse \
    --preview "sed -n '2,6p' $THEME_DIR/{}.sh" --preview-window='right,50%') || exit 0
fi

[[ -r "$THEME_DIR/$NAME.sh" ]] || die "unknown theme '$NAME'. Try: theme list"

# shellcheck source=/dev/null
source "$THEME_DIR/$NAME.sh"

mkdir -p "$XDG_CONFIG_HOME"/{tmux,git,bat,lazygit}

# ── Glyphs as escapes, never literal bytes ───────────────────────
# Private-use (Nerd Font) characters get silently stripped by editors and
# pipes, leaving empty gaps in the status bar. $'\uXXXX' always survives.
# Standard Unicode like │ is safe as a literal.
SEP_R=$'\uE0B0'      # solid right-pointing separator
SEP_L=$'\uE0B2'      # solid left-pointing separator
I_SESSION=$'\uF120'  # terminal
I_BRANCH=$'\uE0A0'   # git branch
I_ZOOM=$'\U000F0293'    # magnify (pane is zoomed)
I_PREFIX=$'\U000F0633'  # command key

# ── 1. The name, plus the resolved nvim colorscheme ─────────────────────
# nvim reads both. Writing the colorscheme here means adding a theme touches
# only themes/<name>.sh — theme.lua does not need its own copy of the map.
printf '%s\n' "$NAME" > "$STATE"
printf '%s\n' "$NVIM_COLORSCHEME" > "$XDG_CONFIG_HOME/theme-nvim"

# ── 2. Ghostty — rewrite the `theme =` line in the committed config ──────
GHOSTTY_CONF="$DOTFILES/ghostty/config"
if [[ -w "$GHOSTTY_CONF" ]]; then
  tmp=$(mktemp)
  sed "s|^theme = .*|theme = $GHOSTTY_THEME|" "$GHOSTTY_CONF" > "$tmp" && mv "$tmp" "$GHOSTTY_CONF"
fi

# ── 3. Prompt palette (zsh/20-prompt.zsh sources this) ───────────
cat > "$XDG_CONFIG_HOME/prompt-theme.zsh" <<EOF
# Generated by \`theme\` — do not edit.
P_BG='$bg'
P_SURFACE='$surface'
P_OVERLAY='$overlay'
P_FG='$fg'
P_MUTED='$muted'
P_BLUE='$blue'
P_TEAL='$teal'
P_GREEN='$green'
P_YELLOW='$yellow'
P_ORANGE='$orange'
P_RED='$red'
P_PURPLE='$purple'
EOF

# ── 4. Shell env: bat's theme (sourced by zsh) ───────────────────────────
cat > "$XDG_CONFIG_HOME/theme-env.sh" <<EOF
# Generated by \`theme\` — do not edit.
export BAT_THEME="$BAT_THEME"
export DELTA_FEATURES=+
EOF

# ── 5. fzf colours ───────────────────────────────────────────────────────
cat > "$XDG_CONFIG_HOME/fzf-theme.sh" <<EOF
# Generated by \`theme\` — do not edit.
export FZF_DEFAULT_OPTS="\$FZF_DEFAULT_OPTS
  --color=fg:$fg,fg+:$fg,bg:-1,bg+:$surface
  --color=hl:$blue,hl+:$cyan,info:$muted,marker:$green
  --color=prompt:$purple,spinner:$teal,pointer:$teal,header:$muted
  --color=border:$overlay,label:$muted,query:$fg
  --color=gutter:-1,preview-bg:-1,separator:$overlay,scrollbar:$overlay"
EOF

# ── 6. delta colours (included by git/gitconfig) ─────────────────────────
cat > "$XDG_CONFIG_HOME/git/delta-theme.conf" <<EOF
# Generated by \`theme\` — do not edit.
[delta]
	syntax-theme = $BAT_THEME
	file-style = bold $yellow
	hunk-header-decoration-style = "$overlay" box ul
	line-numbers-left-style = "$muted"
	line-numbers-right-style = "$muted"
	line-numbers-minus-style = "$red"
	line-numbers-plus-style = "$green"
	line-numbers-zero-style = "$overlay"
	minus-style = syntax "$minus"
	minus-emph-style = syntax "$minus_emph"
	plus-style = syntax "$plus"
	plus-emph-style = syntax "$plus_emph"
	blame-palette = "$bg $surface $overlay"
EOF

# ── 7. tmux status line ──────────────────────────────────────────────────
cat > "$XDG_CONFIG_HOME/tmux/theme.conf" <<EOF
# Generated by \`theme\` — do not edit.
set -g status-position bottom
set -g status-interval 5
set -g status-justify left
set -g status-style "bg=$bg,fg=$fg"
set -g status-left-length 60
set -g status-right-length 90

set -g status-left "#[fg=$bg,bg=$blue,bold] $I_SESSION #S #[fg=$blue,bg=$bg,nobold]$SEP_R#[default] "
set -g status-right "#[fg=$overlay]│ #[fg=$muted]#{?client_prefix,#[fg=$orange]$I_PREFIX PREFIX ,}#[fg=$teal]#(cd '#{pane_current_path}' && git branch --show-current 2>/dev/null | sed 's|^|$I_BRANCH |') #[fg=$overlay]│ #[fg=$muted]%a %d %b #[fg=$fg]%H:%M #[fg=$bg,bg=$blue,bold] #h "

setw -g window-status-format "#[fg=$muted] #I #W#{?window_zoomed_flag, $I_ZOOM,} "
setw -g window-status-current-format "#[fg=$bg,bg=$overlay]$SEP_L#[fg=$cyan,bg=$overlay,bold] #I #W#{?window_zoomed_flag, $I_ZOOM,} #[fg=$overlay,bg=$bg]$SEP_R"
setw -g window-status-separator ""
setw -g window-status-activity-style "fg=$orange"

set -g pane-border-style "fg=$surface"
set -g pane-active-border-style "fg=$blue"
set -g pane-border-lines heavy
set -g display-panes-colour "$muted"
set -g display-panes-active-colour "$teal"

set -g message-style "bg=$surface,fg=$fg"
set -g message-command-style "bg=$surface,fg=$yellow"
set -g mode-style "bg=$overlay,fg=$fg"
set -g copy-mode-match-style "bg=$yellow,fg=$bg"
set -g copy-mode-current-match-style "bg=$orange,fg=$bg"
set -g clock-mode-colour "$blue"
EOF

# ── 8. lazygit colours (merged via LG_CONFIG_FILE) ───────────────────────
cat > "$XDG_CONFIG_HOME/lazygit/theme.yml" <<EOF
# Generated by \`theme\` — do not edit.
gui:
  theme:
    activeBorderColor: ["$blue", bold]
    inactiveBorderColor: ["$muted"]
    searchingActiveBorderColor: ["$orange", bold]
    optionsTextColor: ["$blue"]
    selectedLineBgColor: ["$surface"]
    cherryPickedCommitFgColor: ["$bg"]
    cherryPickedCommitBgColor: ["$purple"]
    markedBaseCommitFgColor: ["$bg"]
    markedBaseCommitBgColor: ["$yellow"]
    unstagedChangesColor: ["$red"]
    defaultFgColor: ["$fg"]
EOF

# ── 9. bat needs its cache rebuilt when the theme set changes ────────────
# (no-op if the theme is a built-in)

# ── 10. cmux — clear its override so it reads the Ghostty config ─────────
# cmux embeds Ghostty and reads ~/.config/ghostty/config, but it can also
# store its OWN theme override in Application Support, which then shadows
# the config (that is how it ended up on Kanagawa Wave while the config said
# TokyoNight Storm).
#
# Do NOT use `cmux themes set` here: its theme list is Ghostty's built-ins
# only, so a custom theme in ghostty/themes/ silently fails to apply and
# cmux stays on whatever it had. Clearing the override instead makes cmux
# resolve the theme from the Ghostty config, which does support user themes.
# One source of truth, and it cannot drift.
if command -v cmux >/dev/null 2>&1; then
  cmux themes clear >/dev/null 2>&1 || true
fi

# ── Live reloads where we can do them ────────────────────────────────────
reloaded=()
if tmux info &>/dev/null; then
  tmux source-file "$XDG_CONFIG_HOME/tmux/tmux.conf" &>/dev/null && reloaded+=("tmux")
fi
if pgrep -qf 'cmux' >/dev/null 2>&1 && command -v cmux >/dev/null 2>&1; then
  # This reloads cmux's config AND the Ghostty config, refreshing terminals
  # in place — no restart, and no keystroke simulation needed.
  cmux reload-config >/dev/null 2>&1 && reloaded+=("cmux")
fi
if pgrep -qx Ghostty; then
  # No CLI hook for a running instance, so drive the menu accelerator.
  if osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' &>/dev/null; then
    reloaded+=("ghostty")
  fi
fi

# ── Report ───────────────────────────────────────────────────────────────
printf '\033[1m theme → %s\033[0m\n' "$NAME"
printf '   ghostty  %s\n' "$GHOSTTY_THEME"
printf '   nvim     %s\n' "$NVIM_COLORSCHEME"
printf '   bat      %s\n' "$BAT_THEME"
printf '   prompt   %s\n' "$NAME"
printf '   also     fzf, delta, tmux, lazygit\n'
command -v cmux >/dev/null 2>&1 && printf '   cmux     inherits the ghostty config\n'

if [[ ${#reloaded[@]} -gt 0 ]]; then
  printf '\033[32m reloaded live:\033[0m %s\n' "${reloaded[*]}"
fi
printf '\033[33m to finish:\033[0m run \033[1mreload\033[0m in each shell'
if ! printf '%s\n' "${reloaded[@]:-}" | grep -q ghostty; then
  printf ', press \033[1mcmd+shift+,\033[0m in Ghostty'
fi
printf ', and \033[1m:ThemeReload\033[0m in any open nvim\n'
