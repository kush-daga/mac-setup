# ═══════════════════════════════════════════════════════════════════════
#  Git.  Work identity is the DEFAULT so nothing about the office setup
#  changes. Personal identity is opt-in per directory via includeIf below.
# ═══════════════════════════════════════════════════════════════════════

# ── Default identity ─────────────────────────────────────────────────────
# Lives OUTSIDE this repo, in ~/.gitconfig.local, so no email address is
# ever committed. install.sh creates it from git/gitconfig.local.example.
[include]
	path = ~/.gitconfig.local

# ── Personal identity, scoped by directory ───────────────────────────────
# Anything under these paths uses ~/.dotfiles/git/gitconfig-personal instead.
# The trailing slash matters — it means "this dir and everything below it".
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/git/gitconfig-personal
[includeIf "gitdir:~/personal/"]
	path = ~/.dotfiles/git/gitconfig-personal

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.dotfiles/git/gitignore
	autocrlf = input
	# Watch the filesystem instead of stat-ing every file — big speedup on
	# large repos. Requires git >= 2.37 on macOS.
	fsmonitor = true
	untrackedCache = true

[column]
	ui = auto

[branch]
	sort = -committerdate          # most recent branches first in `git branch`

[tag]
	sort = version:refname

# ── Diffing ──────────────────────────────────────────────────────────────
[diff]
	algorithm = histogram          # far better hunk detection than the default
	colorMoved = plain             # show moved code differently from add/delete
	mnemonicPrefix = true          # i/w/c prefixes instead of a/b
	renames = copies
	tool = difftastic

[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true

[merge]
	conflictstyle = zdiff3         # shows the common ancestor in conflicts
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "nvimdiff"]
	cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

# ── Rebasing & pulling ───────────────────────────────────────────────────
[pull]
	rebase = true
[rebase]
	autoSquash = true              # honour fixup!/squash! commits automatically
	autoStash = true               # stash dirty worktree, rebase, unstash
	updateRefs = true              # move dependent branches along with a rebase
[rerere]
	enabled = true                 # remember conflict resolutions and replay them
	autoupdate = true

# ── Pushing ──────────────────────────────────────────────────────────────
[push]
	default = simple
	autoSetupRemote = true         # `git push` on a new branch just works
	followTags = true

[fetch]
	prune = true                   # delete local refs for deleted remote branches
	pruneTags = true
	all = true

# ── Safety ───────────────────────────────────────────────────────────────
[transfer]
	fsckObjects = true
[fetch "fsck"]
	objects = true
[receive]
	fsckObjects = true

[help]
	autocorrect = prompt           # "did you mean...?" instead of guessing

[commit]
	verbose = true                 # show the diff while writing the message
	template = ~/.dotfiles/git/gitmessage

[status]
	showUntrackedFiles = all
	submoduleSummary = true

[log]
	date = iso
[rev-parse]
	abbrevRef = loose

[interactive]
	diffFilter = delta --color-only --features=interactive

[apply]
	whitespace = fix

[submodule]
	recurse = true

[advice]
	detachedHead = false
	skippedCherryPicks = false

# ── Git LFS (preserved from the existing setup) ───────────────────────────
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# ═══════════════════════════════════════════════════════════════════════
#  delta — the pager. Side-by-side diffs with syntax highlighting.
#  Colours come from ~/.config/git/delta-theme.conf, written by `theme`.
# ═══════════════════════════════════════════════════════════════════════
[delta]
	navigate = true                # n / N jump between files in the diff
	side-by-side = true
	line-numbers = true
	hyperlinks = true
	true-color = always
	file-decoration-style = none
	hunk-header-style = file line-number syntax
	map-styles = "bold purple => syntax #34385f, bold cyan => syntax #1f3a3a"
	width = variable
	max-line-length = 2048
	wrap-max-lines = 2

[delta "interactive"]
	keep-plus-minus-markers = false

# Theme colours, regenerated by the `theme` command.
[include]
	path = ~/.config/git/delta-theme.conf

# ═══════════════════════════════════════════════════════════════════════
#  Aliases — the ones worth typing. Shell-level ones live in 40-shell.zsh.
# ═══════════════════════════════════════════════════════════════════════
[alias]
	# Log views
	l = log --oneline --graph --decorate -20
	ll = log --graph --pretty=format:'%C(auto)%h%d %s %C(blue)(%an, %ar)'
	last = log -1 HEAD --stat
	today = log --since=midnight --oneline --author-date-order
	mine = "!git log --author=\"$(git config user.email)\" --oneline -20"
	# Inspecting
	s = status --short --branch
	d = diff
	ds = diff --staged
	dw = diff --word-diff=color
	who = shortlog --summary --numbered --email
	# Branch hygiene
	brs = branch --sort=-committerdate --format='%(HEAD) %(color:cyan)%(refname:short)%(color:reset) %(color:dim)%(committerdate:relative)%(color:reset) %(contents:subject)'
	gone = "!git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}'"
	# Undo
	unstage = restore --staged
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	# Finding things
	grep-all = "!f() { git rev-list --all | xargs git grep \"$1\"; }; f"
	# Where am I
	root = rev-parse --show-toplevel
	branch-name = rev-parse --abbrev-ref HEAD
	# Sync
	sync = "!git fetch --all --prune && git pull --rebase --autostash"
